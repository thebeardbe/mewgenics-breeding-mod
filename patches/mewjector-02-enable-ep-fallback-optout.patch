--- a/chainloader.ini
+++ b/chainloader.ini
@@ -23,6 +23,13 @@
 ; Default: 1
 Logging=1
 
+; Patch the game's PE entry point so mods load even if the game never calls a
+; version.dll export. Set to 0 to skip that patch; mods then load on the first
+; proxy call. Relevant when the entry-point patch races with game startup
+; (seen on some Proton/Wine setups).
+; Default: 1
+EnableEPFallback=1
+
 [LoadOrder]
 
 ; Force specific mods to load first, in the order listed here.
