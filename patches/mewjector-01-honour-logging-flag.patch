+/* Read only the Logging flag, before the log file is opened, so Logging=0
+ * produces no log output and no file. LoadConfig re-reads everything later. */
+static void ReadLoggingFlag(void)
+{
+    char iniPath[MAX_PATH];
+    char buf[64];
+    snprintf(iniPath, MAX_PATH, "%schainloader.ini", g_baseDir);
+    GetPrivateProfileStringA("Chainloader", "Logging", "1",
+                             buf, sizeof(buf), iniPath);
+    TrimInPlace(buf);
+    g_logEnabled = (buf[0] == '1' || buf[0] == 'y' || buf[0] == 'Y');
+}
